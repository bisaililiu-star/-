.question-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}

.question-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.question-title {
  font-size: 30rpx;
  font-weight: 700;
}

.favorite-tag {
  font-size: 22rpx;
  color: #2b73ff;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid #2b73ff;
}

.favorite-tag.active {
  color: #ffffff;
  background: #2b73ff;
}

.stem {
  font-size: 30rpx;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.option-item {
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d8dbe3;
  background: #fafbff;
}

.option-item.selected {
  border-color: #2b73ff;
  background: #edf4ff;
}

.analysis-wrap {
  margin-top: 24rpx;
  border-top: 1rpx solid #eceff5;
  padding-top: 18rpx;
}

.analysis-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.analysis-text {
  color: #555555;
  line-height: 1.6;
}
