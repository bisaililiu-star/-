.upload-actions {
  margin-top: 22rpx;
  display: flex;
  gap: 16rpx;
}

.upload-actions button {
  flex: 1;
}

.button-plain {
  background: #ffffff;
  color: #2b73ff;
  border: 1rpx solid #2b73ff;
  border-radius: 12rpx;
}

.preview-image {
  width: 100%;
  height: 320rpx;
  margin: 20rpx 0;
  border-radius: 12rpx;
  background: #f2f4f9;
}

.note-input {
  width: 100%;
  min-height: 180rpx;
  border: 1rpx solid #d8dbe3;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 8rpx 0 12rpx;
}

.record-card {
  display: flex;
  gap: 14rpx;
}

.record-image {
  width: 160rpx;
  height: 120rpx;
  border-radius: 10rpx;
  background: #f1f3f8;
}

.record-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.record-note {
  font-size: 28rpx;
}

.record-time {
  color: #888888;
  font-size: 22rpx;
}
