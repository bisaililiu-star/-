.empty-card .subtitle {
  margin-top: 10rpx;
  display: block;
}

.progress-card {
  margin-bottom: 18rpx;
}

.progress-text {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.mode-text {
  display: block;
  margin-top: 8rpx;
  color: #666666;
  font-size: 24rpx;
}

.submit-wrap {
  margin-top: 18rpx;
}

.submit-result {
  display: block;
  margin-top: 10rpx;
  min-height: 36rpx;
  color: #2b73ff;
}

.nav-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.nav-actions button {
  flex: 1;
}

.button-plain {
  background: #ffffff;
  color: #2b73ff;
  border: 1rpx solid #2b73ff;
  border-radius: 12rpx;
}
