.stats-card {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.stats-item {
  width: calc(50% - 9rpx);
  background: #f8faff;
  border-radius: 12rpx;
  padding: 18rpx;
}

.stats-num {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #2b73ff;
}

.stats-label {
  color: #666666;
  font-size: 24rpx;
}

.action-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.action-title {
  font-size: 30rpx;
  font-weight: 600;
}

.action-desc {
  color: #666666;
  font-size: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 8rpx 0 12rpx;
}

.upload-card {
  display: flex;
  gap: 14rpx;
}

.upload-image {
  width: 160rpx;
  height: 120rpx;
  border-radius: 10rpx;
  background: #f1f3f8;
}

.upload-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.upload-note {
  font-size: 28rpx;
}

.upload-time {
  color: #888888;
  font-size: 22rpx;
}
